**/android/key.properties

# Publish state (per-machine)
issues/.published.json

# Design tool caches
design/.thumbnail

# Rolling rate-limit ledger (per-machine)
.rate-budget.json

# Local compiler metadata (contains machine-specific paths)
app/web/*.js.deps
app/web/*.js.map

# Melos IDE metadata
**/*.iml
